# Jötai Runner Environment Configuration

# The provider to use for LLM generation (gemini or stub)
LLM_PROVIDER=stub

# Gemini specific settings (only required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Node.js Backend URL
NODE_API_URL=http://localhost:5000/api/v1

# Service-to-service authentication token
RUNNER_SERVICE_TOKEN=your_secure_runner_service_token_here
