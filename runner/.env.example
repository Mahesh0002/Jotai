# Jötai Runner Environment Configuration

# Provider: "stub" for local dev/tests, "gemini" for live calls.
LLM_PROVIDER=stub

# Gemini settings (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Node.js backend URL
NODE_API_URL=http://localhost:5000/api/v1

# Service-to-service token. Must match RUNNER_SERVICE_TOKEN on the Node side.
RUNNER_SERVICE_TOKEN=your_secure_runner_service_token_here

# Optional: scope Runner calls to one user (sends x-jotai-user-id).
# Leave empty for global internal automation.
RUNNER_USER_ID=

# Redis (optional for the API; the consumer needs it)
REDIS_URL=redis://localhost:6379

# Server-side chat trimming: last N turns, bounded sessions (LRU + TTL)
CHAT_HISTORY_TURNS=6
CHAT_MAX_SESSIONS=1000
CHAT_SESSION_TTL_SECONDS=3600
PENDING_ACTION_TTL_SECONDS=600
